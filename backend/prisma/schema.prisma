generator client {

 provider = "prisma-client-js"

}

datasource db {

 provider = "sqlite"

 url      = env("DATABASE_URL")

}

model Student {

 id       Int     @id @default(autoincrement())

 name     String

 math     Int

 science  Int

 english  Int
 
 total    Int?
 
 average  Float?

 grade    String?

}