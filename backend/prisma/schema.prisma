generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum Role {
  HOD
  FACULTY
  STUDENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- Models ---

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(FACULTY)
  status        UserStatus     @default(APPROVED)
  createdAt     DateTime       @default(now())
  registrationMetadata Json?
  
  // Relations
  leaves          Leave[]        @relation("UserLeaves")
  approvedLeaves  Leave[]        @relation("ApprovedLeaves")
  refreshTokens   RefreshToken[]
  
  // Profiles
  faculty  Faculty?
  student  Student?
  
  // Department HOD relation
  managedDept     Department?    @relation("DeptHOD")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  hodId     Int?      @unique
  hod       User?     @relation("DeptHOD", fields: [hodId], references: [id])
  
  faculty   Faculty[]
  students  Student[]
  courses   Course[]
  virtualClassrooms VirtualClassroom[]
  
  createdAt DateTime  @default(now())
}

model Faculty {
  id           Int        @id @default(autoincrement())
  userId       Int?       @unique
  user         User?      @relation(fields: [userId], references: [id])
  
  name         String
  email        String?    @unique
  phone        String
  address      String
  photoUrl     String?    @db.Text
  
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  
  // Assignments
  courses      Course[]   // Many-to-Many: Faculty teach many courses
  students     Student[]  // Many-to-Many: Faculty assigned to many students (Mentorship/Advisor)
  
  timetable    Timetable[]
  attendanceRecords Attendance[]
  materials    CourseMaterial[]
  virtualClassrooms VirtualClassroom[]
  
  createdAt    DateTime   @default(now())

  @@index([departmentId])
}

model Student {
  id            Int              @id @default(autoincrement())
  userId        Int?             @unique
  user          User?            @relation(fields: [userId], references: [id])
  
  name          String
  email         String           @unique
  phone         String
  address       String
  photoUrl      String?          @db.Text
  
  // Guardian Details
  guardianName    String?
  guardianPhone   String?
  guardianAddress String?
  
  // Parent / Next of Kin (Required for portal access)
  nextOfKinName   String?
  nextOfKinPhone  String?
  
  departmentId  Int
  department    Department       @relation(fields: [departmentId], references: [id])
  
  batch         String           // e.g., "2022-2026"
  year          Int              // e.g., 1, 2, 3, 4
  semester      Int
  
  attendanceRate Float           @default(0)
  feeStatus     String           @default("Unpaid")
  feeDue        Float            @default(5000)
  lastPaymentDate DateTime?
  feePermitted   Boolean          @default(false)
  feePermissionReason String?      @db.Text
  
  // Assignments
  faculty       Faculty[]        // Many-to-Many: Assigned faculty members
  courses       Course[]         // Many-to-Many: Enrolled courses
  
  academicReports AcademicReport[]
  attendanceRecords Attendance[]
  assignments     Assignment[]
  transactions    Transaction[]
  
  createdAt     DateTime         @default(now())

  @@index([departmentId])
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  dueDate     DateTime
  status      String   @default("PENDING") // PENDING, COMPLETED
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
  createdAt   DateTime @default(now())

  @@index([studentId])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  amount      Float
  date        DateTime @default(now())
  status      String   @default("SUCCESS")
  description String
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model Course {
  id           Int        @id @default(autoincrement())
  name         String
  code         String     @unique
  credits      Int        @default(4)
  semester     Int        @default(1)
  
  // Prerequisites (Self-relation)
  prerequisites Course[]   @relation("CoursePrerequisites")
  requiredFor   Course[]   @relation("CoursePrerequisites")
  
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  
  faculty      Faculty[]
  students     Student[]
  
  timetable    Timetable[]
  attendance   Attendance[]
  materials    CourseMaterial[]
  virtualClassrooms VirtualClassroom[]

  @@index([departmentId])
}

model VirtualClassroom {
  id                 Int        @id @default(autoincrement())
  topic              String     @default("Virtual Classroom Session")
  meetingLink        String     @db.Text
  departmentId       Int
  department         Department @relation(fields: [departmentId], references: [id])
  semester           Int
  courseId           Int?
  course             Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  facultyId          Int
  faculty            Faculty    @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  capacity           Int        @default(56)
  activeParticipants Int        @default(0)
  createdAt          DateTime   @default(now())

  @@index([departmentId])
  @@index([courseId])
  @@index([facultyId])
}

model Attendance {
  id          Int              @id @default(autoincrement())
  studentId   Int
  facultyId   Int
  courseId    Int?
  
  date        DateTime         @default(now())
  period      String?          // e.g. "10:00 AM - 11:00 AM" or "Slot 1"
  status      AttendanceStatus @default(PRESENT)
  
  student     Student          @relation(fields: [studentId], references: [id])
  faculty     Faculty          @relation(fields: [facultyId], references: [id])
  course      Course?          @relation(fields: [courseId], references: [id])

  @@index([studentId])
  @@index([facultyId])
  @@index([courseId])
}

model Timetable {
  id          Int      @id @default(autoincrement())
  facultyId   Int
  courseId    Int?
  
  subject     String   // Legacy or fallback
  section     String
  room        String
  startTime   String   // e.g., "10:00 AM"
  endTime     String   // e.g., "11:00 AM"
  dayOfWeek   String   // e.g., "Monday"
  type        String   @default("Lecture")
  
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  course      Course?  @relation(fields: [courseId], references: [id])

  @@index([facultyId])
}

model AcademicReport {
  id         Int     @id @default(autoincrement())
  studentId  Int
  subject    String
  marks      Float
  grade      String
  Student    Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model Leave {
  id          Int         @id @default(autoincrement())
  userId      Int
  userName    String
  userRole    Role        // Using Role Enum
  leaveType   String      
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveStatus @default(PENDING)
  
  user        User        @relation("UserLeaves", fields: [userId], references: [id])
  approvedById Int?
  approvedBy   User?      @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  priority  String   @default("Normal")
  category  String   @default("General")
  targetRole Role?   // Using Role Enum
  createdAt DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  eventDate   DateTime
}

model CourseMaterial {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  fileUrl     String   @db.Text
  fileName    String
  category    String   @default("Notes Synopsis/E-material")
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  facultyId   Int
  faculty     Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([courseId])
  @@index([facultyId])
}