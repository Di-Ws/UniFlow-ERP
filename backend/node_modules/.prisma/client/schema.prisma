generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("Faculty") // Roles: "HOD", "Faculty"
  createdAt DateTime @default(now())
}

model Student {
  id             Int              @id @default(autoincrement())
  name           String
  email          String           @unique
  phone          String
  address        String
  branch         String
  section        String
  semester       Int
  attendance     Float
  feeStatus      String // Paid or Unpaid
  academicReport AcademicReport[]
  teachers       Teacher[] // New Many-to-Many mapping
  createdAt      DateTime         @default(now())
}

model AcademicReport {
  id        Int     @id @default(autoincrement())
  studentId Int
  subject   String
  marks     Float
  grade     String
  Student   Student @relation(fields: [studentId], references: [id])
}

model Teacher {
  id         Int       @id @default(autoincrement())
  name       String
  email      String?   @unique // Optional for existing records
  department String    @default("General")
  subject    String
  phone      String
  address    String
  photoUrl   String
  students   Student[] // Assigned students array
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  eventDate   DateTime
}

model Leave {
  id         Int      @id @default(autoincrement())
  userId     Int
  userName   String
  userRole   String // "Student", "Faculty", "HOD"
  leaveType  String // "Sick", "Casual", "Academic", "Other"
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("Pending") // "Pending", "Approved", "Rejected"
  reviewedBy String? // Name of HOD who approved/rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
